{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadObject",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::aws-cli-file-pipeline-abdullah-2026/sample.txt"
    },
    {
      "Sid": "SQSReceiveDelete",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "QUEUE_ARN"
    },
    {
      "Sid": "SNSPublish",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "SNS_TOPIC_ARN"
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "LOG_GROUP_ARN:*"
    }
  ]
}
